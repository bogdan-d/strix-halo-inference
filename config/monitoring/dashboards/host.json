{
  "uid": "strix-halo-host",
  "title": "Strix Halo / Host",
  "description": "Optional host monitoring. Kernel counters are not engine allocations or guaranteed free application memory.",
  "tags": [
    "strix-halo",
    "host"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Host telemetry",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Kernel memory counters are **not guaranteed application headroom**. Halogen's pinned weights can appear reclaimable in `MemAvailable`. GTT excludes some resident engine memory."
      }
    },
    {
      "id": 2,
      "title": "CPU busy",
      "type": "stat",
      "description": "Non-idle share across logical CPUs, including I/O wait. Requires several scrapes.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "strix-host"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "strix-host"
          },
          "expr": "(100 * (1 - avg by(job, instance) (rate(node_cpu_seconds_total{job=\"host\",mode=\"idle\"}[$__rate_interval])))) and on(job, instance) (up{job=\"host\"} == 1)",
          "legendFormat": "CPU",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "title": "GPU busy",
      "type": "stat",
      "description": "AMDGPU driver busy percentage. Includes all GPU users.",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "strix-host"
