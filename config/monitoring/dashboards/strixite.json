{
  "uid": "strix-halo-strixite",
  "title": "Strix Halo / Strixite",
  "description": "Strixite 0.2.4 native aggregate metrics, independent health probing and explicit completion-accounting semantics.",
  "tags": [
    "strix-halo",
    "strixite"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Strixite telemetry",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Strixite 0.2.4.** Prefill totals update after prefill; generation and MTP totals update at finalization. Last-speed gauges retain the last qualifying request while idle. `live_tokens` is the last worker-completion session size, not live progress. Cache bytes are not total engine memory. [Host dashboard](/d/strix-halo-host)."
      }
    },
    {
      "id": 2,
      "title": "Metrics scrape",
      "type": "stat",
      "description": "Successful collection, not model readiness.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "strix-host"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "strix-host"
          },
          "expr": "up{job=\"strixite\"}",
          "legendFormat": "Health",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Readiness collection",
      "type": "stat",
      "description": "Up means the probe ran, not that it passed.",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "strix-host"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "strix-host"
          },
          "expr": "up{job=\"strixite-ready\"}",
          "legendFormat": "Health",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "title": "Model readiness",
      "type": "stat",
      "description": "HTTP 200 and JSON status ok. Busy is independent. Startup degradation and configured capacity must be inspected separately.",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "strix-host"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not ready",
                  "color": "orange"
                },
                "1": {
                  "text": "Ready",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "strix-host"
          },
          "expr": "probe_success{job=\"strixite-ready\"} and on(job, instance) (up{job=\"strixite-ready\"} == 1)",
          "legendFormat": "Health",
          "instant": true,
          "range": false
        }
      ]
    },
    {
