      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "strix-host"
          },
          "expr": "((rate(strix_mtp_accepted_tokens_total{job=\"strixite\"}[$__rate_interval]) / rate(strix_mtp_drafted_tokens_total{job=\"strixite\"}[$__rate_interval])) and on(job, instance) (rate(strix_mtp_drafted_tokens_total{job=\"strixite\"}[$__rate_interval]) > 0)) and on(job, instance) (up{job=\"strixite\"} == 1)",
          "legendFormat": "Accepted fraction",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 11,
      "title": "Prompt-cache buffer and disk bytes",
      "type": "timeseries",
      "description": "RAM-entry and spare-buffer capacities are separate from disk bytes. RAM and disk may contain the same state. Not engine RAM/GPU footprint. Launcher disk cap is 16 GiB, not a measured metric.",
