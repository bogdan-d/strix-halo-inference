        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "strix-host"
          },
          "expr": "(strix_prompt_cache_bytes{job=\"strixite\"}) and on(job, instance) (up{job=\"strixite\"} == 1)",
          "legendFormat": "Disk",
          "instant": false,
