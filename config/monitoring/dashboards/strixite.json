          },
          "expr": "(strix_queue_depth{job=\"strixite\"}) and on(job, instance) (up{job=\"strixite\"} == 1)",
          "legendFormat": "Queued",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "title": "Context capacity and last completed session",
