    {
      "id": 7,
      "title": "Last qualifying request speed",
      "type": "timeseries",
      "description": "Retained historical gauges while idle. Prefill is new tokens over prompt-phase time; decode excludes the first completion token. Zero before measurement is hidden.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "strix-host"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "strix-host"
          },
          "expr": "(strix_last_prefill_tokens_per_second{job=\"strixite\"} > 0) and on(job, instance) (up{job=\"strixite\"} == 1)",
          "legendFormat": "Last prefill",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "strix-host"
          },
          "expr": "(strix_last_decode_tokens_per_second{job=\"strixite\"} > 0) and on(job, instance) (up{job=\"strixite\"} == 1)",
          "legendFormat": "Last decode",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Completion-accounted wall-time throughput",
      "type": "timeseries",
      "description": "Tokens per wall second including idle. New prompt tokens commit after prefill; generation and cache accounting can appear as bursts, not live decode speed.",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "strix-host"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "strix-host"
          },
          "expr": "(rate(strix_prefill_tokens_total{job=\"strixite\"}[$__rate_interval])) and on(job, instance) (up{job=\"strixite\"} == 1)",
          "legendFormat": "New prefill",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "strix-host"
          },
          "expr": "(rate(strix_generated_tokens_total{job=\"strixite\"}[$__rate_interval])) and on(job, instance) (up{job=\"strixite\"} == 1)",
          "legendFormat": "Generated",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "strix-host"
          },
          "expr": "(rate(strix_prompt_tokens_cached_total{job=\"strixite\"}[$__rate_interval])) and on(job, instance) (up{job=\"strixite\"} == 1)",
          "legendFormat": "Reused prefix",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Windowed reused-token share",
      "type": "stat",
      "description": "Reused tokens divided by full prompt tokens. No prompt work is unavailable, not zero. Not request cache-hit probability.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "strix-host"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "strix-host"
          },
          "expr": "((rate(strix_prompt_tokens_cached_total{job=\"strixite\"}[$__rate_interval]) / rate(strix_prompt_tokens_total{job=\"strixite\"}[$__rate_interval])) and on(job, instance) (rate(strix_prompt_tokens_total{job=\"strixite\"}[$__rate_interval]) > 0)) and on(job, instance) (up{job=\"strixite\"} == 1)",
          "legendFormat": "Reused prompt fraction",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 10,
      "title": "Windowed draft acceptance",
      "type": "stat",
      "description": "Accepted drafts divided by drafted tokens. Finalization-accounted; no proposals is unavailable. Not proof of speedup.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "strix-host"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
