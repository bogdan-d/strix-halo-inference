          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "strix-host"
          },
          "expr": "(strix_busy{job=\"strixite\"}) and on(job, instance) (up{job=\"strixite\"} == 1)",
          "legendFormat": "Busy",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
